# --- Backend (backend/.env, loaded by pydantic-settings) --------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DATABASE_URL=sqlite:///./data/orbit.db
CHROMA_PATH=./chroma_db
# Absolute path for uploaded files; empty = backend/uploads
UPLOADS_DIR=
REDIS_URL=redis://redis:6379
JWT_SECRET=

# --- Environment / security -------------------------------------------------
ENVIRONMENT=development
DEBUG=true
# Must be true behind HTTPS (Render/Vercel) so the session cookie is Secure
COOKIE_SECURE=false
# Comma-separated allowed browser origins (or a JSON list)
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Demo seed (NovaTech Systems: folders + admin/hr/eng accounts) ----------
# Tri-state: true = always seed · false = never · unset = seed only on first
# launch when the database is empty. See README "Demo data".
SEED_DEMO=true

# --- Frontend (frontend/.env.local) -----------------------------------------
# Default: same-origin /api proxy (next.config.ts) pointing at localhost:8000.
# API_PROXY_URL=http://localhost:8000
# Set on Vercel to proxy at the deployed API:
# API_PROXY_URL=https://your-api.onrender.com
# Optional overrides:
# NEXT_PUBLIC_API_URL=            # empty = use the /api proxy
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/orbit
